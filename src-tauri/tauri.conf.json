{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARKALI",
  "version": "0.1.0",
  "identifier": "dev.arkali.command-center",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && ..\\.venv\\Scripts\\python.exe ..\\scripts\\build_desktop_backend.py",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARKALI Command Center",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/arkali-backend-x86_64-pc-windows-msvc.exe": "arkali-backend.exe"
    }
  }
}
